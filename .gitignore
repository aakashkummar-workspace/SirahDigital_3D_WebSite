# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
/build
next-env.d.ts

# secrets — never commit these
.env
.env*.local
!.env.example

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo
/.next-verify/

# Every .env variant, including backups like .env.local.bak-* .
# The narrow patterns above missed those and they hold live secrets.
.env*
!.env.example

# Dev build output and server logs
/.next-dev*/
*.log
