# Copy to .env.local and fill in. .env.local is git-ignored.

# --- WhatsApp notifications (Sirah Messenger gateway) ---------------------
# On each consultation-form submission the team is messaged on WhatsApp.
# The instance is identified by the token, so WHATSAPP_INSTANCE is only used
# in logs. Leave WHATSAPP_TO blank to disable notifications.
WHATSAPP_API_URL=https://chat.sirahagents.com
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=SirahDigital
# Digits only, with country code, e.g. 919789961631
WHATSAPP_TO=

# --- Optional extra destination ------------------------------------------
# Leads are also POSTed here as JSON (n8n, Make, a CRM, ...). Optional.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Country code prefixed when a visitor types a bare national number.
WHATSAPP_DEFAULT_CC=91
