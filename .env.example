# Copy to .env.local and fill in. .env.local is git-ignored.

# --- WhatsApp notifications (Sirah Messenger gateway) ---------------------
# On each consultation-form submission the team is messaged on WhatsApp.
# The instance is identified by the token, so WHATSAPP_INSTANCE is only used
# in logs. Leave WHATSAPP_TO blank to disable notifications.
WHATSAPP_API_URL=https://chat.sirahagents.com
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=SirahDigital
# Digits only, with country code, e.g. 919789961631
WHATSAPP_TO=

# --- Lead persistence (required) ------------------------------------------
# Contact submissions are written into the CMS `leads` collection through
# POST {CMS_URL}/api/lead-intake. That endpoint exists because leads.create is
# closed to the API entirely, and the site is a separate process from the CMS so
# it cannot use Payload's Local API.
#
# Must be byte-identical to LEAD_INTAKE_SECRET in sirah-cms/.env. Unset (or
# mismatched) and nothing is stored: the submission survives only as a server log
# line, and if no WhatsApp recipient is configured either, /api/contact answers
# 502 and tells the visitor to email instead rather than faking a success.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEAD_INTAKE_SECRET=

# Salt for leads.ipHash (salted SHA-256, for abuse investigation). The raw IP is
# never stored. Unset, no hash is written at all — an unsalted IP hash is
# reversible across the entire IPv4 space in minutes, so it would only look
# anonymous.
IP_HASH_SALT=

# --- Optional extra destination ------------------------------------------
# Leads are also POSTed here as JSON (n8n, Make, a CRM, ...). Optional, and
# independent of the CMS write above.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Country code prefixed when a visitor types a bare national number.
WHATSAPP_DEFAULT_CC=91

# --- Internal ------------------------------------------------------------
# /animations is the internal 3D preview. It is always available in dev; set
# this to 1 to expose it on a staging deploy. Leave unset in production.
ENABLE_ANIMATION_LAB=

# --- Booking --------------------------------------------------------------
# Nothing to set here any more.
#
# Booking used to need NEXT_PUBLIC_TIDYCAL_PATH, pointing at a TidyCal booking
# type whose availability lived in their dashboard. That variable is gone. /book
# now reads open times from the CMS through this app's own /api/slots and
# confirms through /api/book, and both are server routes here — so they
# authenticate with CMS_URL and LEAD_INTAKE_SECRET below, the same two variables
# the contact form already needed. Delete NEXT_PUBLIC_TIDYCAL_PATH from any
# .env.local you have; nothing reads it.
#
# If /book says there are no free times, the cause is one of three, in order:
#   1. no slots generated yet        -> CMS admin, /admin/availability
#   2. CMS_URL wrong or the CMS down -> the site logs "[slots] list failed"
#   3. Google not configured         -> listing works, confirming fails instead
#
# Availability (Mon-Sat 10:00-20:00 IST, Sunday closed) is generated at
# /admin/availability in the CMS and stored as rows, not configured here.

# ── CMS ───────────────────────────────────────────────────────────────────
# Where the Payload CMS lives. The chatbot reads its knowledge index from this
# over the REST API at request time (src/lib/chat/cms.js), so content added in
# the admin becomes answerable without a redeploy.
#
# Unset is a supported state, not a broken one: /api/chat falls back to the
# index webpack froze into the bundle from src/data, which is exactly how the
# bot behaved before the CMS was wired in. If the bot is not seeing new CMS
# content, check this first — a missing value fails quiet by design.
CMS_URL=http://localhost:3001

# Shared with the CMS, and must be byte-identical to the value in its .env.
# The CMS signs an HMAC over every revalidation ping with it; a mismatch fails
# closed and silently, so edits save fine in the admin and simply never appear
# here — on the site or in the chatbot.
REVALIDATE_SECRET=
